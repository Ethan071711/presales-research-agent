# Copy values into your shell; .env is not loaded implicitly.
# Default run uses curated public battery facts and no paid LLM API.
PRESALES_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/postgres?sslmode=disable
PRESALES_EMBED_MODEL=BAAI/bge-small-zh-v1.5
PRESALES_MODEL_MODE=extractive
# Optional: local Transformers model; requires sufficient RAM/VRAM and a model download/cache.
# PRESALES_MODEL_MODE=local
# PRESALES_LOCAL_MODEL=Qwen/Qwen3-4B-Instruct-2507
# A random local JWT signing key is generated in .storage/jwt.key on first run.
# On deployment provide a secret instead, remove demo login, and use your identity provider.
# Optional: a private, explicitly obtained supplier pricebook. Never commit it.
PRESALES_PRICEBOOK=
# Cost estimate per million measured tokens, in CNY. Local inference defaults to zero.
PRESALES_INPUT_CNY_PER_MILLION=0
PRESALES_OUTPUT_CNY_PER_MILLION=0
